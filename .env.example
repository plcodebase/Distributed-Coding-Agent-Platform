# Local-development values only. Replace every value outside an isolated workstation.
AGENT_PLATFORM_ENVIRONMENT=development
AGENT_PLATFORM_LOG_LEVEL=INFO
AGENT_PLATFORM_LOG_JSON=true

POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=local-postgres-change-me
AGENT_PLATFORM_DATABASE_URL=postgresql+asyncpg://agent_platform:local-postgres-change-me@127.0.0.1:5432/agent_platform

AGENT_PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0

MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-change-me
AGENT_PLATFORM_S3_ENDPOINT=http://127.0.0.1:9000
AGENT_PLATFORM_S3_ACCESS_KEY=local-minio
AGENT_PLATFORM_S3_SECRET_KEY=local-minio-change-me
AGENT_PLATFORM_S3_BUCKET=agent-platform

LITELLM_MASTER_KEY=sk-local-litellm-change-me
# Local development only; release composition must use an immutable @sha256 digest.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.89.4
AGENT_PLATFORM_GATEWAY_URL=http://127.0.0.1:4000
AGENT_PLATFORM_GATEWAY_API_KEY=sk-local-litellm-change-me
LITELLM_CONFIG_FILE=/config/litellm-config.fake.yaml

# Required only when LITELLM_CONFIG_FILE=/config/litellm-config.yaml.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
